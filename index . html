.btn-outline{background:transparent;border:1px solid white;color:white}
section{padding:55px 5%;scroll-margin-top:70px}
.section-title{text-align:center;font-size:clamp(25px,5vw,36px);
margin:0 0 10px}
.subtitle{text-align:center;color:#64776b;margin:0 auto 28px;max-width:650px}
.about{background:#fff}
.feature-grid,.district-grid{display:grid;
grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:14px}
.feature{background:#f0f5e9;border-radius:16px;padding:20px;text-align:center}
.feature span{font-size:30px}
.feature h3{margin:8px 0 3px}
.feature p{font-size:14px;margin:0;color:#617268}
.callout{max-width:750px;margin:28px auto 0;background:#eaf1df;
padding:20px;border-radius:15px;text-align:center}
.district-section{background:#edf2e7}
.search{display:block;width:100%;max-width:600px;margin:0 auto 24px;
padding:14px 17px;border:1px solid #c8d5c7;border-radius:12px;
background:white;outline-color:#397859}
.district-card{background:white;border:1px solid #e0e8dd;
border-radius:15px;padding:17px;text-align:left;color:#20352b;
box-shadow:0 3px 10px #1c42200a;transition:transform .2s}
.district-card:hover{transform:translateY(-3px)}
.district-card .emoji{font-size:28px}
.district-card strong{display:block;font-size:16px}
.district-card small{color:#68786d}
.details{max-width:800px;margin:28px auto 0;background:white;
border-radius:18px;padding:22px;box-shadow:0 5px 20px #173b2910}
.details h3{font-size:25px;margin:0}
.place{padding:13px 0;border-bottom:1px solid #e4eae1}
.place:last-child{border:0}
.place p{margin:4px 0;color:#657469}
.maplink{color:#176a46;font-weight:bold}
.hidden{display:none!important}
.back{border:1px solid #b9c9b8;background:white;border-radius:25px;
padding:8px 15px;margin-bottom:16px}
footer{background:#163c32;color:#e8f0e8;text-align:center;padding:28px 15px}
footer p{font-size:14px}
@media(max-width:500px){
 header{padding:10px 4%;flex-wrap:wrap}
 .logo{font-size:17px}
 nav button{font-size:12px;padding:5px 9px}
 section{padding:40px 4%}
 .feature-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
 .district-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
 .district-card{padding:12px}
 .details{padding:16px}
}
</style>
</head>

