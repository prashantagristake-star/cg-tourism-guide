<title>CG Tourism Guide | चलो छत्तीसगढ़ घूमते हैं</title>

<style>
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:Arial,"Noto Sans Devanagari",sans-serif;
background:#f5f7f0;color:#20352b;line-height:1.7}
button,input{font:inherit}
button{cursor:pointer}
header{position:sticky;top:0;z-index:5;background:#163c32;
color:white;padding:12px 5%;display:flex;align-items:center;
justify-content:space-between;gap:10px}
.logo{font-size:19px;font-weight:bold}
nav{display:flex;gap:8px;flex-wrap:wrap}
nav button{background:transparent;color:white;border:1px solid #739184;
border-radius:20px;padding:6px 12px}
.hero{min-height:85vh;display:flex;align-items:center;
justify-content:center;text-align:center;padding:35px 20px;color:white;
background:radial-gradient(ellipse at 75% 15%,#b5cb81 0,transparent 32%),
linear-gradient(145deg,#102f28,#27634b 60%,#71915c)}
.hero-content{max-width:750px}
.tag{color:#e1edb8;letter-spacing:2px;font-size:13px}
h1{font-size:clamp(36px,8vw,64px);line-height:1.2;margin:18px 0}
.hero p{font-size:18px;color:#e5efe8}
.btn{border:0;border-radius:30px;padding:12px 22px;
