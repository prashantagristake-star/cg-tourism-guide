const grid = document.getElementById("districtGrid");

function renderDistricts(list){
  grid.innerHTML = "";
  list.forEach(d => {
    const button = document.createElement("button");
    button.className = "district-card";
    button.innerHTML = `<span class="emoji">${d[2]}</span>
      <strong>${d[1]}</strong><small>${d[0]}</small>`;
    button.onclick = () => openDistrict(d);
    grid.appendChild(button);
  });
  if(!list.length){
    grid.innerHTML = "<p>यह जिला नहीं मिला। नाम दोबारा खोजें।</p>";
  }
}

function filterDistricts(){
  const q = document.getElementById("search").value.trim().toLowerCase();
  renderDistricts(districts.filter(d =>
    d[0].toLowerCase().includes(q) || d[1].toLowerCase().includes(q)
  ));
}

function openDistrict(d){
  document.getElementById("districtTitle").textContent = d[2]+" "+d[1];
  document.getElementById("districtIntro").textContent =
    d[1]+" जिले की पर्यटन गाइड। यहाँ दी गई जगहों की जानकारी यात्रा से पहले जाँचें।";
  const box = document.getElementById("places");
  box.innerHTML = "";
  d[3].forEach((place,i) => {
    const row = document.createElement("div");
    row.className = "place";
    const title = document.createElement("strong");
    title.textContent = (i+1)+". "+place;
    const p = document.createElement("p");
    p.textContent = "यात्रा की योजना बनाने से पहले स्थान और रास्ते की जानकारी की पुष्टि करें।";
    row.append(title,p);
    box.appendChild(row);
  });
  document.getElementById("details").classList.remove("hidden");
  document.getElementById("details").scrollIntoView({behavior:"smooth"});
}

function closeDetails(){
  document.getElementById("details").classList.add("hidden");
  document.getElementById("districts").scrollIntoView({behavior:"smooth"});
}

function go(id){
  document.getElementById(id).scrollIntoView({behavior:"smooth"});
}

renderDistricts(districts);
</script>
